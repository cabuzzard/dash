# All paid integrations start disabled. Never commit .env.
RENTCAST_ENABLED=false
RENTCAST_API_KEY=
RENTCAST_MONTHLY_BUDGET=0
RENTCAST_COST_RESERVATION=0
REGRID_ENABLED=false
REGRID_API_KEY=
REGRID_MONTHLY_BUDGET=0
REGRID_COST_RESERVATION=0
PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_MONTHLY_BUDGET=0
PERPLEXITY_COST_RESERVATION=0
# Agent is the documented successor; sonar enables the compatibility endpoint.
PERPLEXITY_MODE=agent
# Free government API credential, optional
BEA_API_KEY=
