            "sel": ".hero p.lead"
          },
          "section": "Hero"
        },
        {
          "id": "hero_cta_primary",
          "label": "Hero primary CTA",
          "type": "text",
          "default": "Book your free strategy call",
          "bind": {
            "sel": ".hero-actions a:first-child"
