    {
      "group": "CTA · Hero",
      "asset": "CTA",
      "note": "CTA asset, Hero kind (child of the Audit Offer, the default CTA destination). Fills the top of the page and the header button.",
      "fields": [
        {
          "id": "nav_cta",
          "label": "Nav CTA button",
          "type": "text",
          "default": "Book Free Strategy Call",
          "bind": {
            "sel": "header nav a.nav-cta"
          },
          "section": "Header"
        },
        {
          "id": "hero_eyebrow",
          "label": "Hero eyebrow",
          "type": "text",
          "default": "For small business owners",
          "bind": {
            "sel": ".hero .eyebrow"
          },
          "section": "Hero"
        },
        {
          "id": "hero_headline",
          "label": "Hero headline",
          "type": "text",
          "default": "Get AI working in your business — without hiring a team",
          "bind": {
            "sel": ".hero h1"
          },
          "section": "Hero"
        },
        {
          "id": "hero_sub",
          "label": "Hero subheadline",
          "type": "textarea",
          "default": "We implement, integrate, and hand over working AI automation so your team can use it from day one. No more tools that sit unused.",
