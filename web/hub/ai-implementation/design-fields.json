          "section": "Hero"
        },
        {
          "id": "hero_cta_secondary",
          "label": "Hero secondary CTA",
          "type": "text",
          "default": "See the services",
          "bind": {
            "sel": ".hero-actions a.btn-ghost"
          },
          "section": "Hero"
        },
        {
          "id": "hero_image",
          "label": "Hero image URL or base64",
          "type": "image",
          "default": "",
          "bind": {
            "sel": ".hero-visual img",
            "attr": "src"
          },
          "section": "Hero"
        }
      ]
    },
    {
