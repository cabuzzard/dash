  "comboMap": {
    "primary": "color_green",
    "bright": "color_green_bright",
    "dark": "color_green_dark",
    "darker": "color_green_darker",
    "soft": "color_green_soft",
    "mid": "color_green_mid",
    "ink": "color_ink",
    "muted": "color_muted",
    "bg": "color_bg"
  },
  "grouping": "2026-11-21: groups = the Asset Flow asset type that writes each field (CTA, Offer, Hub) + no-asset groups; \"section\" = where the field sits on the page. Ids and bindings unchanged."
}
